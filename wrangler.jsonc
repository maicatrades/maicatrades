{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "maicatrades",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "maicatrades"
    },
    {
      "binding": "BREADTH_WORKER_1",
      "service": "maicatrades-breadth-1"
    },
    {
      "binding": "BREADTH_WORKER_2",
      "service": "maicatrades-breadth-2"
    },
    {
      "binding": "BREADTH_WORKER_3",
      "service": "maicatrades-breadth-3"
    },
    {
      "binding": "BREADTH_WORKER_4",
      "service": "maicatrades-breadth-4"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}